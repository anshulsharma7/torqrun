# Copy to .env (git-ignored) to override defaults used by deploy/compose/docker-compose.yml.
# `make up` creates .env automatically (with a random enrollment token) if it doesn't exist.
# The defaults are for local development only; change POSTGRES_PASSWORD for anything shared.
POSTGRES_PASSWORD=torqrun_dev
POSTGRES_PORT=55432
# Raise when running several API replicas (each may use up to 20 connections).
POSTGRES_MAX_CONNECTIONS=200
API_PORT=8000
WEB_PORT=8080

TORQRUN_ENVIRONMENT=development
TORQRUN_LOG_LEVEL=INFO
# json (default, for log shipping) or console (easier to read locally)
TORQRUN_LOG_FORMAT=json

# Lets the bundled agent enroll itself. Development only (the API refuses it otherwise).
# Generated by tools/dev/init-env.sh; any string of 16+ characters works.
TORQRUN_DEV_ENROLLMENT_TOKEN=
# Master key that encrypts job secrets (AES-256-GCM), 32+ characters. Generated by
# tools/dev/init-env.sh. Back it up: secrets encrypted with a lost key cannot be recovered.
TORQRUN_SECRET_KEY=
# Optional: create this admin on first start (otherwise the web UI asks you to create one).
TORQRUN_BOOTSTRAP_ADMIN_EMAIL=
TORQRUN_BOOTSTRAP_ADMIN_PASSWORD=
# How long a silent agent keeps its runs before they are declared LOST (API + scheduler).
TORQRUN_LEASE_TTL_SECONDS=60

# Bundled agent
TORQRUN_AGENT_NAME=compose-agent
TORQRUN_AGENT_MAX_SLOTS=4

# Externally reachable URL (https://torqrun.example.com). Used for agent install commands and
# links in notifications. Leave empty on a laptop.
TORQRUN_PUBLIC_URL=

# Email notifications (optional). Slack, Teams and webhooks need nothing here.
TORQRUN_SMTP_HOST=
TORQRUN_SMTP_PORT=587
TORQRUN_SMTP_USERNAME=
TORQRUN_SMTP_PASSWORD=
TORQRUN_SMTP_FROM=
